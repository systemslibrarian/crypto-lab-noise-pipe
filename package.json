{
  "name": "crypto-lab-noise-pipe",
  "version": "1.0.0",
  "private": true,
  "description": "Interactive demo of the Noise Protocol Framework — composable handshake patterns for secure channels",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "deploy": "npm run build && gh-pages -d dist",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:claims": "playwright test e2e/claims.spec.ts",
    "test:a11y": "playwright test e2e/a11y.spec.ts"
  },
  "dependencies": {
    "@noble/curves": "^2.4.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.62.1",
    "gh-pages": "^6.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.10"
  }
}
